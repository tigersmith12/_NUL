{
  "name": "nul-desktop-companion",
  "version": "0.1.3",
  "private": true,
  "description": "An offline, non-LLM autonomous ontology lab and desktop companion.",
  "homepage": "https://github.com/tigersmith12/_NUL",
  "main": "desktop/main.cjs",
  "desktopName": "nul-companion.desktop",
  "author": {
    "name": "NUL Experiment",
    "email": "noreply@users.noreply.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "start:low-memory": "electron . --low-memory",
    "start:sandbox": "node scripts/sandbox-server.mjs",
    "start:tui": "node scripts/companion-tui.mjs",
    "dev": "electron . --lab",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never && node scripts/generate-checksums.mjs && node scripts/verify-dist.mjs win",
    "dist:mac": "electron-builder --mac --publish never && node scripts/generate-checksums.mjs && node scripts/verify-dist.mjs mac",
    "dist:linux": "electron-builder --linux --publish never && node scripts/generate-checksums.mjs && node scripts/verify-dist.mjs linux",
    "pack": "electron-builder --dir",
    "test": "node --test tests/*.test.mjs",
    "world:inspect": "node scripts/inspect-world.mjs",
    "bench:memory": "node --expose-gc scripts/measure-memory.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "branch:suggest": "node scripts/check-naming.mjs --suggest",
    "version:set": "node scripts/check-naming.mjs --set-version",
    "version:next": "node scripts/check-naming.mjs --next-version"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ai.nul.companion",
    "productName": "NUL Companion",
    "executableName": "nul-companion",
    "asar": true,
    "electronDownload": {
      "checksums": {
        "electron-v45.2.3-darwin-arm64.zip": "4d7c429064087a47b855d9bd06c76ead4819b7f02b385de232d4a5c37ecef55f",
        "electron-v45.2.3-darwin-x64.zip": "d87323533cc8750ef177e5b48058f7a8b381f677d4e103cc63360006c08829c2",
        "electron-v45.2.3-linux-arm64.zip": "397c060fd9da99ab72b78787d65545b432fcadf13ef6c96658e4f525692aae0f",
        "electron-v45.2.3-linux-x64.zip": "a87fe741f6d121285117e574da6c9a2e65210d410123bbc04713b099add0263b",
        "electron-v45.2.3-win32-arm64.zip": "f664bd7a4adfc45ac237a6f5fbf6c8e041b71b174466e9cb6fc9416c918e249d",
        "electron-v45.2.3-win32-x64.zip": "489cd061908e697394b004298bf5ffd345c935d10e8ca197ba819f019ab2dec0"
      }
    },
    "files": [
      "index.html",
      "src/**/*",
      "desktop/**/*",
      "assets/**/*",
      "README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "NUL-Companion-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "NUL-Companion-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "NUL-Companion-${version}-win-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "NUL-Companion-${version}-win-portable.${ext}"
    }
  }
}
